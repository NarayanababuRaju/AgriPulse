# --- AgriPulse Backend Configuration Template ---

# 1. API Keys
# Get your Gemini API Key from: https//aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Get your Google Maps Weather API Key from: https://console.cloud.google.com/google/maps-apis/
# (Required for localized weather context)

# OpenWeatherMap API Key
WEATHER_API_KEY=your-openweathermap-api-key

# 2. Google Cloud Platform (GCP)
# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=config/service-account.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=gcp-location

# 3. Storage & Database
GCS_BUCKET_NAME=your-gcs-bucket-name
FIRESTORE_DATABASE_ID=your-firestore-database-id

# 4. Server Settings
PORT=8080
LOG_LEVEL=info
DEBUG=True

# 5. Firebase (for Auth validation)
FIREBASE_PROJECT_ID=your-firebase-project-id
